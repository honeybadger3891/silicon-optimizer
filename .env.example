# API keys for Scripts/verify-cloud.sh
#
# Copy this to .env and fill it in. .env is gitignored; this template must never hold a key.
#
# Paste a key after the "=" with no quotes and no spaces. Leave a line blank to skip that
# provider — the script reports it as skipped rather than failed.

# Free, no card. Rate limited rather than metered.  https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# One key, most of the industry's models.          https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat, plus the speech and music queue.           https://console.gmicloud.ai/apikeys
GMI_API_KEY=
